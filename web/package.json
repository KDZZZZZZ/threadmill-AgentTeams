{
  "name": "@threadmill/operator-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "npm run build && node scripts/build-e2e-host.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "lucide-react": "1.31.0",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
